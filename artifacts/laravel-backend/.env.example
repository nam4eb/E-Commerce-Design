APP_NAME="Điện Máy 365"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dienmay365
DB_USERNAME=dienmay365
DB_PASSWORD=

INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_THROW_ON_ERROR=true

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=
CSP_REPORT_ONLY=false
HSTS_MAX_AGE=31536000
ADMIN_MFA_REQUIRED=true
WEBHOOK_MAX_BYTES=262144

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_MAX_UPLOAD_KB=5120
QUEUE_CONNECTION=database
QUEUE_WARNING_SIZE=100
FAILED_JOBS_WARNING=1
FAILED_WEBHOOKS_WARNING=1
PAYMENT_WEBHOOK_TOLERANCE=300
MANUAL_PAYMENT_WEBHOOK_SECRET=
SHIPPING_WEBHOOK_TOLERANCE=300
MANUAL_SHIPPING_WEBHOOK_SECRET=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/dang-nhap/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/dang-nhap/facebook/callback
CHATBOT_ENABLED=true
CHATBOT_SERVICE_URL=http://localhost:8001
CHATBOT_SERVICE_SECRET=
CHATBOT_DB_USERNAME=dienmay365_chatbot
CHATBOT_DB_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
