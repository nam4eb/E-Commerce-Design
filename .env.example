# Copy to root .env. node scripts/dev-api.mjs loads it. Never commit real keys.
PORT=5000
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_FILE=.data/shop.sqlite
SEED_CATALOG=true
# Production: use PostgreSQL and HTTPS, omit DATABASE_FILE.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# NODE_ENV=production
# Set a unique email and password (12+ characters) for initial admin provisioning.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Docker has exactly one Nginx proxy hop. Adapt to your production topology.
TRUST_PROXY=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Use the version assigned to your Meta app (vNN.0, NN = actual number).
FACEBOOK_GRAPH_VERSION=
PAYMENT_ENV=sandbox
PAYMENTS_LIVE_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Optional server public IP for querydr, as agreed with VNPAY.
VNPAY_QUERY_IP=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
CONTACT_PHONE=
CONTACT_ZALO_URL=
CONTACT_FACEBOOK_URL=

# Vercel AI Gateway. Both values are required to enable the chatbot.
AI_GATEWAY_API_KEY=
# Choose an exact model ID shown in your AI Gateway dashboard.
AI_MODEL=
AI_CHAT_SYNC_ENABLED=true
# Docker Compose local settings (PUBLIC_ORIGIN should be http://localhost:8080).
WEB_PORT=8080
DOCKER_PUBLIC_ORIGIN=http://localhost:8080
POSTGRES_DB=electronics_store
POSTGRES_USER=store
# Always replace outside local development.
POSTGRES_PASSWORD=local-change-me
DOCKER_NODE_ENV=development
# Frontend development shell only, comma-separated trusted tunnel hostnames.
# DEV_ALLOWED_HOSTS=your-tunnel.example
