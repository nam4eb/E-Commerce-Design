{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:commerce": "node scripts/test-commerce.mjs",
    "eval:ai": "pnpm --filter @workspace/api-server run build && node artifacts/api-server/dist/eval-ai-chatbot.mjs",
    "ai:index-knowledge": "pnpm --filter @workspace/api-server run build && node artifacts/api-server/dist/index-ai-knowledge.mjs",
    "test:rag": "pnpm --filter @workspace/api-server run build && node artifacts/api-server/dist/test-rag.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
